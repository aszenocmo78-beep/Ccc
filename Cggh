-- ตรวจสอบและลบ UI เก่าทิ้งก่อนสร้างใหม่
local CoreGui = game:GetService("CoreGui")
if CoreGui:FindFirstChild("CarSpeedGui") then
    CoreGui.CarSpeedGui:Destroy()
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

-- ตัวแปรสถานะ
local isBoostActive = false
local targetSpeed = 150 -- ค่าความเร็วเริ่มต้น (หน่วย Studs/วินาที)
local boostConnection = nil

-- สร้าง ScreenGui หลัก
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "CarSpeedGui"
screenGui.Parent = CoreGui
screenGui.ResetOnSpawn = false

-- สร้างปุ่มเปิด-ปิด UI (Toggle Menu)
local toggleMenuBtn = Instance.new("TextButton")
toggleMenuBtn.Name = "ToggleMenuBtn"
toggleMenuBtn.Size = UDim2.new(0, 130, 0, 40)
toggleMenuBtn.Position = UDim2.new(0, 20, 0.5, -100)
toggleMenuBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
toggleMenuBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleMenuBtn.TextSize = 14
toggleMenuBtn.Font = Enum.Font.SourceSansBold
toggleMenuBtn.Text = "ซ่อนเมนูรถ"
toggleMenuBtn.Parent = screenGui
toggleMenuBtn.Active = true
toggleMenuBtn.Draggable = true

-- สร้างกรอบหน้าต่างหลัก (Main Frame)
local mainFrame = Instance.new("Frame")
mainFrame.Name = "MainFrame"
mainFrame.Size = UDim2.new(0, 230, 0, 135)
mainFrame.Position = UDim2.new(0, 20, 0.5, -50)
mainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
mainFrame.BorderSizePixel = 0
mainFrame.Parent = screenGui
mainFrame.Active = true
mainFrame.Draggable = true

-- ข้อความหัวข้อ
local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, 0, 0, 30)
titleLabel.BackgroundTransparency = 1
titleLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
titleLabel.TextSize = 16
titleLabel.Font = Enum.Font.SourceSansBold
titleLabel.Text = "ระบบบูสต์ความเร็วรถ"
titleLabel.Parent = mainFrame

-- ช่องพิมพ์ตัวเลขความเร็วรถ
local speedInput = Instance.new("TextBox")
speedInput.Name = "SpeedInput"
speedInput.Size = UDim2.new(0.9, 0, 0, 35)
speedInput.Position = UDim2.new(0.05, 0, 0.28, 0)
speedInput.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
speedInput.TextColor3 = Color3.fromRGB(255, 255, 255)
speedInput.PlaceholderText = "ใส่ความเร็วรถ (เช่น 150, 300)"
speedInput.Text = tostring(targetSpeed)
speedInput.TextSize = 14
speedInput.Font = Enum.Font.SourceSans
speedInput.ClearTextOnFocus = false
speedInput.Parent = mainFrame

-- ปุ่มแตะเปิด-ปิด บูสต์พุ่งทันที (Boost Toggle Button)
local boostBtn = Instance.new("TextButton")
boostBtn.Name = "BoostBtn"
boostBtn.Size = UDim2.new(0.9, 0, 0, 38)
boostBtn.Position = UDim2.new(0.05, 0, 0.62, 0)
boostBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60) -- สีแดง = ปิดอยู่
boostBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
boostBtn.TextSize = 16
boostBtn.Font = Enum.Font.SourceSansBold
boostBtn.Text = "สถานะ: ปิด (แตะเพื่อพุ่ง)"
boostBtn.Parent = mainFrame

-- ฟังก์ชันควบคุมความเร็วรถ
local function updateCarVelocity()
    local char = player.Character
    if not char then return end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    -- ตรวจสอบว่ากำลังนั่งอยู่บนที่นั่งคนขับ (VehicleSeat) หรือไม่
    if humanoid and humanoid.SeatPart and humanoid.SeatPart:IsA("VehicleSeat") then
        local seat = humanoid.SeatPart
        -- ดึงความเร็วแนวตั้งเดิมไว้ (เพื่อไม่ให้รถลอยค้างกลางอากาศหรือจมดิน)
        local currentY = seat.AssemblyLinearVelocity.Y
        -- คำนวณทิศทางพุ่งไปข้างหน้าตามหน้าของที่นั่งคนขับ
        local forwardVelocity = seat.CFrame.LookVector * targetSpeed
        
        seat.AssemblyLinearVelocity = Vector3.new(forwardVelocity.X, currentY, forwardVelocity.Z)
    end
end

-- ระบบเปิด-ปิด UI เมนู
local isMenuOpen = true
toggleMenuBtn.MouseButton1Click:Connect(function()
    isMenuOpen = not isMenuOpen
    mainFrame.Visible = isMenuOpen
    toggleMenuBtn.Text = isMenuOpen and "ซ่อนเมนูรถ" or "เปิดเมนูรถ"
end)

-- อัปเดตค่าความเร็วเมื่อพิมพ์เสร็จ
speedInput.FocusLost:Connect(function()
    local val = tonumber(speedInput.Text)
    if val and val >= 0 then
        targetSpeed = val
    else
        speedInput.Text = tostring(targetSpeed)
    end
end)

-- กดปุ่มเปิด/ปิด บูสต์พุ่งทันที
boostBtn.MouseButton1Click:Connect(function()
    -- อัปเดตค่าตัวเลขจากช่องพิมพ์ก่อนเปิดใช้งานเผื่อผู้ใช้ยังไม่กด Enter
    local val = tonumber(speedInput.Text)
    if val and val >= 0 then
        targetSpeed = val
    end

    isBoostActive = not isBoostActive

    if isBoostActive then
        boostBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 90) -- สีเขียว = เปิดทำงาน
        boostBtn.Text = "สถานะ: เปิดพุ่ง (" .. targetSpeed .. ")"
        
        -- รันลูปส่งแรงพุ่งทุกเฟรม (Heartbeat)
        boostConnection = RunService.Heartbeat:Connect(updateCarVelocity)
    else
        boostBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60) -- สีแดง = ปิด
        boostBtn.Text = "สถานะ: ปิด (แตะเพื่อพุ่ง)"
        
        if boostConnection then
            boostConnection:Disconnect()
            boostConnection = nil
        end
    end
end)
